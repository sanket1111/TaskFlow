@model TaskFlow.Web.ViewModels.Project.ProjectDetailsViewModel

@{
    ViewData["Title"] = "Project Details";
}

<h1>Project Details</h1>

<div>
    <h4>@Model.ProjectName</h4>

    <dl class="row">
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>

        <dt class="col-sm-2">Priority</dt>
        <dd class="col-sm-10">@Model.Priority</dd>

        <dt class="col-sm-2">Start Date</dt>
        <dd class="col-sm-10">@Model.StartDate.ToShortDateString()</dd>

        <dt class="col-sm-2">End Date</dt>
        <dd class="col-sm-10">@Model.EndDate</dd>
    </dl>
    <dl>
        <a asp-controller="TaskItem"
           asp-action="Create"
           asp-route-projectId="@Model.Id"
           class="btn btn-primary">
            Create Task
        </a>
    </dl>
</div>

<h3>Tasks</h3>

@if (Model.TaskItems.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Task</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Due Date</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var task in Model.TaskItems)
            {
                <tr>
                    <td>@task.TaskTitle</td>
                    <td>@task.Status</td>
                    <td>@task.Priority</td>
                    <td>@task.DueDate.ToShortDateString()</td>
                    <td>
                        <a asp-controller="TaskItem"
                           asp-action="Edit"
                           asp-route-id="@task.Id"
                           class="btn btn-primary">
                            Edit Task
                        </a>
                        <form asp-controller="TaskItem" asp-action="Delete"
                              asp-route-id="@task.Id"
                              method="post"
                              style="display:inline">

                            <button type="submit" class="btn btn-danger"
                             onclick="return confirm('Are you sure you want to delete this task?');" >
                                Delete
                            </button>
                        </form>
                    </td>                    
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No tasks found for this project.</p>
}