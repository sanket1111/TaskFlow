@model TaskFlow.Web.ViewModels.Project.ProjectDetailsViewModel

@{
    ViewData["Title"] = "Project Details";
}
<div class="container">
    <div class="col-sm-12 d-inline-flex justify-content-between mb-4 ">
        <div class="col-sm-9 d-flex align-items-center">
            <h1>Project Details</h1>
        </div>
        <div class="col-sm-3 d-flex justify-content-end align-items-center">
            <a asp-controller="Project" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-1 ">Edit Project</a>
            <a asp-action="Index" class="btn btn-primary">Back</a>
        </div>
    </div>



    <div class="card mb-4">
        <div class="card-header">
            <h4>@Model.ProjectName</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-2">Description</dt>
                <dd class="col-sm-10">@Model.Description</dd>

                <dt class="col-sm-2">Status</dt>
                <dd class="col-sm-10">
                    @if (@Model.Status == ProjectStatus.InProgress)
                    {
                        <span class="badge text-bg-primary">In Progress</span>
                    }
                    else if (@Model.Status == @ProjectStatus.Completed)
                    {
                        <span class="badge text-bg-success">@Model.Status</span>
                    }
                    else if (Model.Status == @ProjectStatus.Canceled)
                    {
                        <span class="badge text-bg-danger">@Model.Status</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">
                            @Model.Status
                        </span>
                    }
                </dd>
                <dt class="col-sm-2">Priority</dt>
                <dd class="col-sm-10">
                    @if (Model.Priority == ProjectPriority.Critical)
                    {
                        <span class="badge text-bg-dark">@Model.Priority</span>
                    }
                    else if (Model.Priority == ProjectPriority.Medium)
                    {
                        <span class="badge text-bg-warning">@Model.Priority</span>
                    }
                    else if (Model.Priority == ProjectPriority.High)
                    {
                        <span class="badge text-bg-danger">@Model.Priority</span>
                    }
                    else if (Model.Priority == ProjectPriority.Low)
                    {
                        <span class="badge text-bg-success">@Model.Priority</span>
                    }
                </dd>

                <dt class="col-sm-2">Start Date</dt>
                <dd class="col-sm-10">@Model.StartDate.ToString("dd-MMM-yyyy")</dd>

                <dt class="col-sm-2">End Date</dt>
                <dd class="col-sm-10">@(Model.EndDate?.ToString("dd-MMM-yyyy") ?? "-")</dd>
            </dl>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h3>Tasks</h3>

                <a asp-controller="TaskItem"
                   asp-action="Create"
                   asp-route-projectId="@Model.Id" class="btn btn-primary">
                    + Create Task
                </a>
            </div>
        </div>
        <div class="card-body">
            @if (Model.TaskItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead class="table-light">
                            <tr>
                                <th>Task</th>
                                <th>Status</th>
                                <th>Priority</th>
                                <th>Due Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var task in Model.TaskItems)
                            {
                                <tr>
                                    <td>@task.TaskTitle</td>
                                    <td>@task.Status</td>
                                    <td>@task.Priority</td>
                                    <td>@task.DueDate.ToString("dd-MMM-yyyy")</td>
                                    <td>
                                        <a asp-controller="TaskItem"
                                           asp-action="Edit"
                                           asp-route-id="@task.Id"
                                           class="btn btn-primary">
                                            Edit Task
                                        </a>
                                        <form asp-controller="TaskItem" asp-action="Delete"
                                              asp-route-id="@task.Id"
                                              method="post"
                                              style="display:inline">

                                            <button type="submit" class="btn btn-danger"
                                                    onclick="return confirm('Are you sure you want to delete this task?');">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p>No tasks found for this project.</p>
            }
        </div>
    </div>
</div>