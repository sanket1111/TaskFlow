@model IEnumerable<TaskFlow.Web.ViewModels.Project.ProjectListViewModel>


<h1>Project List</h1>

<form asp-action="Index" method="get">
    <div class="row">
        <div class="col-md-3">
            <input type="text"
                   name="searchTerm"
                   value="@Context.Request.Query["searchTerm"]"
                   placeholder="Search projects..."
                   class="form-control" />
        </div>

        <div class="col-md-3">
            <select name="priority"
                    class="form-select">
                <option value="">All Priorities</option>

                @foreach (var priority in Enum.GetValues<TaskFlow.Web.Models.Enum.ProjectPriority>())
                {
                    <option value="@priority"
                            selected="@(Context.Request.Query["priority"] == priority.ToString())">
                        @priority
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="status"
                    class="form-select">
                <option value="">All Statuses</option>
                @foreach (var status in Enum.GetValues<TaskFlow.Web.Models.Enum.ProjectStatus>())
                {
                    <option value="@status"
                            selected="@(Context.Request.Query["status"] == status.ToString())">
                        @status
                    </option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </div>
</form>

    
<table class="table">
    <thead>
        <tr>
            <th>Project Name</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var project in Model)
        {
            <tr>
                <td>@project.ProjectName</td>
                <td>@project.Status</td>
                <td>@project.Priority</td>
                <td>@project.StartDate.ToString("dd-MMM")</td>
                <td>@project.EndDate?.ToString("dd-MMM")</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = project.Id })" class="btn btn-primary">Edit</a>
                    <form asp-action="Delete"
                          asp-route-id="@project.Id"
                          method="post"
                          style="display:inline">

                        <button type="submit" class="btn btn-danger">
                            Delete
                        </button>
                    </form>
                    <a asp-action="Details"
                       asp-route-id="@project.Id"
                       class="btn btn-info">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>    