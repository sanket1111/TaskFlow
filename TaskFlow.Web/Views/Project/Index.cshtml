@model ProjectListPageViewModel


<h1>Project List</h1>

<form asp-action="Index" method="get">
    <div class="row">
        <div class="col-md-3">
            <input asp-for="Filter.SearchTerm"
                   placeholder="Search projects..."
                   class="form-control" />
        </div>

        <div class="col-md-3">
            <select asp-for="Filter.Priority"
                    asp-items="Html.GetEnumSelectList<TaskFlow.Web.Models.Enum.ProjectPriority>()"
                    class="form-select">
                <option value="">All Priorities</option>
            </select>
        </div>
        <div class="col-md-3">
            <select asp-for="Filter.Status"
                    asp-items="Html.GetEnumSelectList<TaskFlow.Web.Models.Enum.ProjectStatus>()"
                    class="form-select">
                <option value="">All Statuses</option>
            </select>
        </div>
        <div class="col-md-3">
            <select asp-for="Filter.SortBy"
                    asp-items="Html.GetEnumSelectList<TaskFlow.Web.Models.Enum.ProjectSortField>()"
                    class="form-select">
                <option value="">Sort By</option>
            </select>
        </div>
        <div class="col-md-3">
            <div class="form-check">
                <input asp-for="Filter.SortDescending" class="form-check-input" />
                <label asp-for="Filter.SortDescending" class="form-check-label">
                    Sort Descending
                </label>
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </div>
</form>

    
<table class="table">
    <thead>
        <tr>
            <th>Project Name</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var project in Model.Projects)
        {
            <tr>
                <td>@project.ProjectName</td>
                <td>@project.Status</td>
                <td>@project.Priority</td>
                <td>@project.StartDate.ToString("dd-MMM")</td>
                <td>@project.EndDate?.ToString("dd-MMM")</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = project.Id })" class="btn btn-primary">Edit</a>
                    <form asp-action="Delete"
                          asp-route-id="@project.Id"
                          method="post"
                          style="display:inline">

                        <button type="submit" class="btn btn-danger">
                            Delete
                        </button>
                    </form>
                    <a asp-action="Details"
                       asp-route-id="@project.Id"
                       class="btn btn-info">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>    