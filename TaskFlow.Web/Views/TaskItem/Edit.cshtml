@model TaskFlow.Web.ViewModels.Task.TaskEditViewModel

<div class="container">
    <div class="d-flex align-items-center mb-4">
        <h1>Edit Task</h1>
    </div>    
    <div class="card">
        <div class="card-header">
            Task Details
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div class="mb-3">
                    <label asp-for="TaskTitle"></label>
                    <input asp-for="TaskTitle" class="form-control" />
                    <span asp-validation-for="TaskTitle" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status"
                                asp-items="Html.GetEnumSelectList<TaskFlow.Web.Models.Enum.TaskStatus>()"
                                class="form-select">
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                    <div class="mb-3 col-md-6">
                        <label asp-for="Priority" class="form-label"></label>
                        <select asp-for="Priority"
                                asp-items="Html.GetEnumSelectList<TaskFlow.Web.Models.Enum.TaskPriority>()"
                                class="form-select">
                        </select>
                        <span asp-validation-for="Priority" class="text-danger"></span>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label asp-for="DueDate"></label>
                    <input asp-for="DueDate" type="date" class="form-control" />
                    <span asp-validation-for="DueDate" class="text-danger"></span>
                </div>
                <input asp-for="Id" type="hidden" />
                <input asp-for="ProjectId" type="hidden" />
                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Update Task</button>
                    <a asp-action="Details" asp-controller="project" asp-route-id="@Model.ProjectId"
                        class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
